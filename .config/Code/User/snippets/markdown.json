{
	// Place your snippets for markdown here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"start report heading": {
		"prefix": "report",
		"body": [
			//"# $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND:<br>项目：$1<br>主题：$2"
			"# $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND:<br>项目: $1<br>主题: "
		],
		"description": "Start report header"
	},
	"start table": {
		"prefix": "|",
		"body": [
			"| | |",
			"|-|-|",
			"$1"
		],
		"description": "start table heading"
	},
	"start quote": {
		"prefix": ">",
		"body": [
			"> *\"$1\"*"
		],
		"description": "start quote"
	},
	"start diary heading": {
		"prefix": "diary",
		"body": [
			"$CURRENT_YEAR.$CURRENT_MONTH.$CURRENT_DATE $CURRENT_DAY_NAME-$1 $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND"
		],
		"description": "Start report header"
	},
	"start english report heading": {
		"prefix": "fallout",
		"body": [
			"## $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND:<br>Category: $1<br>Topic: "
		],
		"description": "Start fallout report header"
	}

}
#!/bin/bash

mkdir .vscode
echo '{
	"configurations": [
		{
			"name": "TX: g++ build and debug TXLib project",
			"type": "cppdbg",
			"request": "launch",
			"program": "${command:cmake.launchTargetPath}",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [
				{ "name": "__NV_PRIME_RENDER_OFFLOAD", "value": "1" },
    		{ "name": "__GLX_VENDOR_LIBRARY_NAME", "value": "nvidia" },
    		{ "name": "__VK_LAYER_NV_optimus", "value": "NVIDIA_only" }
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
   				 "ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			],
			"miDebuggerPath": "/usr/bin/gdb",
			"preLaunchTask": "TX: Build and Sync"
		}
	],
	"version": "2.0.0"
}' > .vscode/launch.json
echo '{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "Task generated by Debugger."
		}
	],
	"version": "2.0.0"
}' > .vscode/tasks.json
echo '{
	"tx.devUtils.sourceDirectory": "${workspaceDefaultFolder}",
	//"cmake.configureArgs": ["--log-level=VERBOSE"],
	"C_Cpp.errorSquiggles": "enabled"
}' > .vscode/settings.json

mkdir assets
mkdir config

mkdir libs
cp ~/Programming/dev/libs/TXLib/add_txlib.cmake libs/

mkdir src
echo '#include "Project.hpp"

int main() {
	return 0;
}' > src/main.cpp
echo '#pragma once
#include "tx/txlib.h"
#include <bits/stdc++.h>
' > src/Project.hpp

echo 'build
.vscode/
.cache
chen.bmp' > .gitignore

cp ~/chen.bmp ./chen.bmp

echo 'cmake_minimum_required(VERSION 4.2)

project(TXProject)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_VERIFY_INTERFACE_HEADER_SETS ON)

# install
if(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
    set(CMAKE_INSTALL_PREFIX "$ENV{HOME}/.local" CACHE PATH "Install prefix to ~/.local" FORCE)
endif()

# dependencies

set(libs "${CMAKE_SOURCE_DIR}/libs")
set(src "${CMAKE_SOURCE_DIR}/src")

include("${libs}/add_txlib.cmake")

# TXLib
tx_add_txlib(
	LOCAL_DIR "$ENV{HOME}/Programming/dev/libs/TXLib"
)
set(CMakeUtils "${TXLib_SOURCE_DIR}/cmake")

add_executable(TXProject 
	"${src}/main.cpp"
	"${src}/Project.hpp"
)
target_include_directories(TXProject PRIVATE 
	"${CMAKE_SOURCE_DIR}"
	"${libs}"
	"${src}"
)

# project settings
target_compile_features(TXProject PUBLIC cxx_std_23)

# dependencies
target_link_libraries(TXProject PRIVATE
	TXLib
)

# optimization
include("${CMakeUtils}/set_compile_flags.cmake")
tx_set_compile_flags(TXProject PRIVATE)

# build
set_target_properties(TXProject PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
)

# executable environment
include("${CMakeUtils}/link_dir_to_bin.cmake")
tx_link_dir_to_bin(TXProject "${CMAKE_SOURCE_DIR}/assets")

install(TARGETS TXProject
    RUNTIME DESTINATION bin
)' > CMakeLists.txt

echo '{
	"version": 3,
	"configurePresets": [
		{
			"name": "config_debug",
			"displayName": "config_debug",
			"generator": "Ninja",
			"binaryDir": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "config_release",
			"displayName": "config_release",
			"generator": "Ninja",
			"binaryDir": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "config_profile",
			"displayName": "config_profile",
			"generator": "Ninja",
			"binaryDir": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		}
	],
	"buildPresets": [
		{
			"name": "build_debug",
			"configurePreset": "config_debug"
		},
		{
			"name": "build_release",
			"configurePreset": "config_release"
		},
		{
			"name": "build_profile",
			"configurePreset": "config_profile"
		}
	]
}' > CMakePresets.json

echo '{
	"folders": [
		{
			"name": "Project",
			"path": "."
		},
		{
			"name": "TXLib",
			"path": "/home/TX_Jerry/Programming/dev/libs/TXLib"
		}
	],
	"settings": {
		"cmake.sourceDirectory": "${workspaceFolder:Project}"
  }
}
' > TXProject.code-workspace
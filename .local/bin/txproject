#!/bin/bash

mkdir .vscode
echo '{
	"configurations": [
		{
			"name": "TX: g++ build and debug CMake project",
			"type": "cppdbg",
			"request": "launch",
			"program": "${command:cmake.launchTargetPath}",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
   				"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				},
				{
    	    "description": "Disable symbol downloading",
    	    "text": "set confirm off",
    	    "ignoreFailures": true
    		}
			],
			"miDebuggerPath": "/usr/bin/gdb"
		}
	],
	"version": "2.0.0"
}' > .vscode/launch.json
echo '{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "Task generated by Debugger."
		}
	],
	"version": "2.0.0"
}' > .vscode/tasks.json

mkdir assets
mkdir config

mkdir libs
mkdir libs/TXLib
cd libs/TXLib
curl -O https://raw.githubusercontent.com/TXWD1234/TXLib/main/add_txlib.cmake
cd ../..

mkdir src
echo '#include "Project.hpp"

int main() {
	return 0;
}' > src/main.cpp
echo '#pragma once
#include "tx/txlib.h"
#include <bits/stdc++.h>
' > src/Project.hpp

echo 'build
.vscode/
.cache
chen.bmp' > .gitignore

cp ~/chen.bmp ./chen.bmp

echo 'cmake_minimum_required(VERSION 4.2)

set(libs "${CMAKE_SOURCE_DIR}/libs")
set(src "${CMAKE_SOURCE_DIR}/src")

include("${libs}/TXLib/add_txlib.cmake")

project(TXProject)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# install
if(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
    set(CMAKE_INSTALL_PREFIX "$ENV{HOME}/.local" CACHE PATH "Install prefix to ~/.local" FORCE)
endif()

# dependencies

# TXLib
tx_add_txlib(
	LOCAL_DIR
		/home/TX_Jerry/Programming/dev/libs/TXLib
)
set(CMakeUtils "${TXLib_SOURCE_DIR}/TXCMakeUtils")
include("${CMakeUtils}/optimization.cmake")
include("${CMakeUtils}/link_dir_to_bin.cmake")

add_executable(TXProject 
	"${src}/main.cpp"
	"${src}/Project.hpp"
)
target_include_directories(TXProject PRIVATE 
	"${CMAKE_SOURCE_DIR}"
	"${libs}"
	"${src}"
)

# project settings
target_compile_features(TXProject PUBLIC cxx_std_23)

# dependencies
target_link_libraries(TXProject PRIVATE
	TXLib
)

# optimization
tx_add_release_ops(TXProject)

# build
set_target_properties(TXProject PROPERTIES
	RUNTIME_OUTPUT_DIRECTORY_DEBUG   "${CMAKE_BINARY_DIR}/bin"
	RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_BINARY_DIR}/bin"
)
tx_link_dir_to_bin(TXProject "${CMAKE_SOURCE_DIR}/assets")

install(TARGETS TXProject
    RUNTIME DESTINATION bin
)' > CMakeLists.txt

echo '{
	"version": 3,
	"configurePresets": [
		{
			"name": "config_debug",
			"displayName": "config_debug",
			"generator": "Ninja",
			"binaryDir": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_INSTALL_PREFIX": "dist"
			}
		},
		{
			"name": "config_release",
			"displayName": "config_release",
			"generator": "Ninja",
			"binaryDir": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_INSTALL_PREFIX": "dist"
			}
		},
		{
			"name": "config_profile",
			"displayName": "config_profile",
			"generator": "Ninja",
			"binaryDir": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_INSTALL_PREFIX": "dist"
			}
		}
	],
	"buildPresets": [
		{
			"name": "build_debug",
			"configurePreset": "config_debug"
		},
		{
			"name": "build_release",
			"configurePreset": "config_release"
		},
		{
			"name": "build_profile",
			"configurePreset": "config_profile"
		}
	]
}' > CMakePresets.json

echo '{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "/home/TX_Jerry/Programming/dev/libs/TXLib"
		}
	],
	"settings": {}
}' > TXProject.code-workspace